From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Myghi63 <myghi63@disroot.org>
Date: Tue, 03 Nov 2026 04:53:24 -0300
Subject: [PATCH] audioflinger: Do not suspend AIDL Dolby DAP effect

The DAP exemption matches the legacy type UUID, but DAP_offload reports
the AIDL extension type. Enabling the Dolby volume listener on a track
session then suspends DAP on the output mix, leaving it silent until the
listener closes. Also exempt the effect by its implementation UUID.
---
diff --git a/services/audioflinger/Effects.cpp b/services/audioflinger/Effects.cpp
index 9d737dd63d..970753a3b9 100644
--- a/services/audioflinger/Effects.cpp
+++ b/services/audioflinger/Effects.cpp
@@ -2976,6 +2976,11 @@ static const effect_uuid_t SL_IID_DAP_ = { 0x46d279d9, 0x9be7, 0x453d, 0x9d7c,
                                          { 0xef, 0x93, 0x7f, 0x67, 0x55, 0x87 } };
 const effect_uuid_t * const SL_IID_DAP = &SL_IID_DAP_;
 
+// Dolby DAP_offload: its AIDL HAL reports the extension type, so match the implementation UUID
+static const effect_uuid_t FX_UUID_DAP_OFFLOAD_ = { 0x9d4921da, 0x8225, 0x4f29, 0xaefa,
+                                                  { 0x39, 0x53, 0x7a, 0x04, 0xbc, 0xaa } };
+const effect_uuid_t * const FX_UUID_DAP_OFFLOAD = &FX_UUID_DAP_OFFLOAD_;
+
 /* static */
 bool EffectChain::isEffectEligibleForBtNrecSuspend_l(const effect_uuid_t* type) {
     // Only NS and AEC are suspended when BtNRec is off
@@ -2996,6 +3001,7 @@ bool EffectChain::isEffectEligibleForSuspend(const effect_descriptor_t& desc)
           (memcmp(&desc.type, SL_IID_VISUALIZATION, sizeof(effect_uuid_t)) == 0) ||
           (memcmp(&desc.type, SL_IID_VOLUME, sizeof(effect_uuid_t)) == 0) ||
           (memcmp(&desc.type, SL_IID_DAP, sizeof(effect_uuid_t)) == 0) ||
+          (memcmp(&desc.uuid, FX_UUID_DAP_OFFLOAD, sizeof(effect_uuid_t)) == 0) ||
           (memcmp(&desc.type, SL_IID_DYNAMICSPROCESSING, sizeof(effect_uuid_t)) == 0)))) {
         return false;
     }
--
