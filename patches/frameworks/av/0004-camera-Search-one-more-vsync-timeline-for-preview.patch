From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Myghi63 <myghi63@disroot.org>
Date: Wed, 04 Nov 2026 21:26:04 -0300
Subject: [PATCH] camera: TEST: Search one more vsync timeline for preview

Experiment, not a confirmed fix. With 60 fps HDR preview the sensor keeps a
steady 60 fps, but the display only shows 51-53 fps. The suspicion is that
frames arriving at uneven intervals can't be placed within two timelines, so
they end up on the same vsync and get dropped. Search one more, at the cost of
at most one extra vsync of preview latency. Drop this if the drops stay.
---
diff --git a/services/camera/libcameraservice/device3/Camera3OutputStream.h b/services/camera/libcameraservice/device3/Camera3OutputStream.h
index 5322e1980b..8352174c6d 100644
--- a/services/camera/libcameraservice/device3/Camera3OutputStream.h
+++ b/services/camera/libcameraservice/device3/Camera3OutputStream.h
@@ -482,7 +482,7 @@ class Camera3OutputStream :
     static constexpr nsecs_t kSpacingResetIntervalNs = 50000000LL; // 50 millisecond
     static constexpr nsecs_t kTimelineThresholdNs = 1000000LL; // 1 millisecond
     static constexpr float kMaxIntervalRatioDeviation = 0.05f;
-    static constexpr int kMaxTimelines = 2;
+    static constexpr int kMaxTimelines = 3;
     nsecs_t syncTimestampToDisplayLocked(nsecs_t t, sp<Fence> releaseFence);
 
     // In case of fence being used
