From 5d0015be0d5188506f78af4b85396bc9d5d61cdf Mon Sep 17 00:00:00 2001
From: Myghi63 <myghi63@disroot.org>
Date: Sat, 21 Nov 2026 13:32:52 -0300
Subject: [PATCH] game space: auto-detected games join at the standard mode

Detection on install used to tag the entry with the performance mode,
so a freshly installed game ran the aggressive scene until the user
tuned it. Join at standard; performance is only ever tagged explicitly
from the app. isGameInPerfMode keeps honoring explicit tags.

Change-Id: I3e6b93feb4bf7fc5ffc8794a5c96d4933db62a25
---
 .../core/java/com/android/server/wm/GameListManager.java | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/services/core/java/com/android/server/wm/GameListManager.java b/services/core/java/com/android/server/wm/GameListManager.java
index ec06a118634e..b0a79c20f001 100644
--- a/services/core/java/com/android/server/wm/GameListManager.java
+++ b/services/core/java/com/android/server/wm/GameListManager.java
@@ -37,6 +37,7 @@ class GameListManager {
 
     private static final String GAME_LIST_KEY = "gamespace_game_list";
     private static final String PERF_MODE_VALUE = "2";
+    private static final String STANDARD_MODE_VALUE = "1";
     private static final String DENIED_LIST_KEY = "gamespace_denied_list";
 
     private final Context mContext;
@@ -175,9 +176,11 @@ class GameListManager {
 
         final boolean modified;
         if (add) {
-            modified = !PERF_MODE_VALUE.equals(gameMap.get(packageName));
+            // Auto-detected games join at the standard mode; performance is only
+            // ever tagged explicitly (from the app), never inherited by detection.
+            modified = !gameMap.containsKey(packageName);
             if (modified) {
-                gameMap.put(packageName, PERF_MODE_VALUE);
+                gameMap.put(packageName, STANDARD_MODE_VALUE);
             }
         } else {
             modified = gameMap.remove(packageName) != null;
@@ -191,7 +194,7 @@ class GameListManager {
                 UserHandle.USER_CURRENT);
         synchronized (mGameList) {
             if (add) {
-                mGameList.put(packageName, PERF_MODE_VALUE);
+                mGameList.put(packageName, STANDARD_MODE_VALUE);
             } else {
                 mGameList.remove(packageName);
             }
-- 
