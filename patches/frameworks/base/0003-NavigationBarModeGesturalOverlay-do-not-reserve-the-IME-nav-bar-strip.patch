From ce50098913b8b251e72e96deed85488a50fb520f Mon Sep 17 00:00:00 2001
From: Myghi63 <myghi63@disroot.org>
Date: Sun, 22 Nov 2026 00:25:05 -0300
Subject: [PATCH] NavigationBarModeGesturalOverlay: do not reserve the IME nav
 bar strip

config_imeDrawsImeNavBar=true makes the IME draw the legacy nav bar strip
under the keyboard, which in gesture navigation shows up as an empty gap.
Off by default in framework-res; flip it here so the gestural mode keeps it
off too (crDroid has the same effect behind its 'hide space under keyboard'
toggle). Gestures themselves are untouched: back/overview use the transient
navbar, not this flag.

Change-Id: Ife9ab9d34e78799e6b9b970479d3a534f8305603
---
 .../NavigationBarModeGesturalOverlay/res/values/config.xml      | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/packages/overlays/NavigationBarModeGesturalOverlay/res/values/config.xml b/packages/overlays/NavigationBarModeGesturalOverlay/res/values/config.xml
index 66fc2ae79c38..242dff4e5b02 100644
--- a/packages/overlays/NavigationBarModeGesturalOverlay/res/values/config.xml
+++ b/packages/overlays/NavigationBarModeGesturalOverlay/res/values/config.xml
@@ -31,7 +31,7 @@
     <bool name="config_navBarTapThrough">true</bool>
 
     <!-- Controls whether the IME renders the back and IME switcher buttons or not. -->
-    <bool name="config_imeDrawsImeNavBar">true</bool>
+    <bool name="config_imeDrawsImeNavBar">false</bool>
 
     <!-- Controls the size of the back gesture inset. -->
     <dimen name="config_backGestureInset">30dp</dimen>
-- 
2.56.0

