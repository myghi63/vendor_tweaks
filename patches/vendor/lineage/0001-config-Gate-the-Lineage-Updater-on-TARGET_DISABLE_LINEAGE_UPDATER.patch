From 76e35e5204b6847c2f28bf7ccbf2209e2f095b8a Mon Sep 17 00:00:00 2001
From: Myghi63 <myghi63@disroot.org>
Date: Fri, 13 Nov 2026 20:32:19 -0300
Subject: [PATCH] config: Gate the Lineage Updater on
 TARGET_DISABLE_LINEAGE_UPDATER

The Updater app is built from the Lineage sources but crDroid points its
feed at the official crDroid OTA index (updater_server_url ->
android_vendor_crDroidOTA/<branch>/{device}.json), so an unofficial build
offers the official build for the device. Gate the app and its
/data/crdroid_updates init script so a device tree can drop both.
---
 config/common.mk | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/config/common.mk b/config/common.mk
index b2344627..e8414460 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -154,11 +154,18 @@ PRODUCT_PACKAGES += \
 endif
 
 PRODUCT_PACKAGES += \
-    LineageSettingsProvider \
+    LineageSettingsProvider
+
+# Unofficial builds must not advertise the official crDroid update server
+# (Updater fetches vendor/crDroidOTA/<device>.json). Set TARGET_DISABLE_LINEAGE_UPDATER
+# in the device tree to leave the app and its OTA scratch dir out of the image.
+ifneq ($(TARGET_DISABLE_LINEAGE_UPDATER),true)
+PRODUCT_PACKAGES += \
     Updater
 
 PRODUCT_COPY_FILES += \
     vendor/lineage/prebuilt/common/etc/init/init.lineage-updater.rc:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/init/init.lineage-updater.rc
+endif
 
 # Config
 PRODUCT_PACKAGES += \
-- 
2.56.0

